# Приложение на https://oauth.yandex.ru (права iot:view, iot:control)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Необязательно
PORT=8080
DATA_DIR=data
# Адрес, на котором слушает сервер. 0.0.0.0 — слушать все интерфейсы (нужно
# для доступа из локальной сети, например при деплое на домашний сервер)
HOST=127.0.0.1
# Хосты/IP из локальной сети, которым разрешён доступ к /api/, через запятую,
# например 192.168.1.95. Работает вместе с HOST=0.0.0.0
ALLOWED_HOSTS=
# Адрес сервера для skill smart-home, если сервер работает на другой машине
# (например http://192.168.1.95:8080); если пусто — skill берёт 127.0.0.1:PORT
SMART_HOUSE_URL=
